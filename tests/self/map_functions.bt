test:has_key
{
  @has_key_a[1] = 0;

  if (!has_key(@has_key_a, 1)) {
    return 1;
  }

  if has_key(@has_key_a, 2) {
    return 1;
  }

  $b = 1;
  if (!has_key(@has_key_a, $b)) {
    return 1;
  }

  @has_key_b["longerstr"] = 0;
  if has_key(@has_key_b, "byeasdfasdfasdfasdfasdfasdf") {
    return 1;
  }

  if (!has_key(@has_key_b, "longerstr")) {
    return 1;
  }

  @has_key_c[1, ("hello", (int8)5)] = 0;
  if (!has_key(@has_key_c, (1, ("hello", 5)))) {
    return 1;
  }

  if has_key(@has_key_c, (1, ("bye", (uint16)5))) {
    return 1;
  }

  @has_key_c[2, ("evenlongerstr", 10)] = 0;
  $a = (2, ("evenlongerstr", 10));
  if (!has_key(@has_key_c, $a)) {
    return 1;
  }
}

test:delete_all
{
  @delete_all_a[1] = 1;
  @delete_all_a[2] = 2;
  if (!delete(@delete_all_a)) {
    return 1;
  }
  if (len(@delete_all_a) != 0) {
    return 1;
  }

  // Deleting from an empty map still succeeds
  if (!delete(@delete_all_a)) {
    return 1;
  }

  // The map can be used again after deletion
  @delete_all_a[3] = 3;
  if (len(@delete_all_a) != 1) {
    return 1;
  }

  @delete_all_b[1, "hello"] = count();
  @delete_all_b[2, "world"] = count();
  _ = delete(@delete_all_b);
  if (len(@delete_all_b) != 0) {
    return 1;
  }

  @delete_all_c[1] = hist(10);
  @delete_all_c[2] = hist(100);
  _ = delete(@delete_all_c);
  if (len(@delete_all_c) != 0) {
    return 1;
  }
}

test:delete_map
{
  @delete_map_a[1] = 1;
  if (!has_key(@delete_map_a, 1)) {
    return 1;
  }
  _ = delete(@delete_map_a, 1);
  if has_key(@delete_map_a, 1) {
    return 1;
  }

  @delete_map_b[1, 2] = 2;
  if (!delete(@delete_map_b, (1, 2))) {
    return 1;
  }
  if has_key(@delete_map_b, (1, 2)) {
    return 1;
  }

  // Deleting a missing key returns false
  if delete(@delete_map_b, (5, 6)) {
    return 1;
  }
}

test:bad_delete
{
  @bad_delete[1] = 1;
  $x = delete(@bad_delete, 2);
  $y = delete(@bad_delete, 1);
  if ($x != false) {
    return 1;
  }
  if ($y != true) {
    return 1;
  }
}

test:delete_count_map
{
  @delete_count_map_a[1] = count();
  if (!has_key(@delete_count_map_a, 1)) {
    return 1;
  }
  _ = delete(@delete_count_map_a, 1);
  if has_key(@delete_count_map_a, 1) {
    return 1;
  }
}

test:delete_deprecated
{
  @delete_deprecated_a[1] = 1;
  @delete_deprecated_b[2, "hi"] = 2;
  _ = delete(@delete_deprecated_a[1]);
  _ = delete(@delete_deprecated_b[2, "hi"]);
  if has_key(@delete_deprecated_a, 1) {
    return 1;
  }
  if has_key(@delete_deprecated_b, (2, "hi")) {
    return 1;
  }
}

