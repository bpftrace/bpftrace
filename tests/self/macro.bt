struct macro_typeof_struct {
  char m;
};

macro increment_variable($x)
{
  $x += 1;
}

macro increment_and_return($x)
{
  $x += 1;
  $x
}

macro set_map_element(@x)
{
  @x[1] = 2;
}

macro set_scalar_map(@x)
{
  @x = 2;
}

macro read_map_element(@x)
{
  1 + @x[1]
}

macro expression_add1(x)
{
  x + 1
}

macro expression_add2(y)
{
  y + expression_add1(y)
}

macro expression_add3(z)
{
  z + expression_add2(z)
}

macro statement_add1($x)
{
  $x += 1;
}

macro statement_add2($x)
{
  statement_add1($x);
  $x += 1;
}

macro statement_add3($x)
{
  statement_add2($x);
  $x += 1;
}

macro order_add2(x)
{
  x + order_add1(x)
}

macro order_add3(x)
{
  x + order_add2(x)
}

macro order_add1(x)
{
  x + 1
}

macro add_one(x)
{
  x + 1
}

macro add_two_nested(x)
{
  x + 2
}

macro add_one_nested(x)
{
  add_two_nested(x + 1) + 1
}

macro sizeof_types(a, b)
{
  (sizeof(a[2]) + sizeof(b*)) + sizeof(b)
}

macro nested_sizeof_inner(t)
{
  sizeof(t) + 2
}

macro nested_sizeof_outer(z)
{
  nested_sizeof_inner(typeof(z))
}

macro nested_type_cast(a)
{
  (a*)(-1)
}

macro sum_map_values(@a)
{
  let $sum = 1;
  for $kv : @a {
    $sum += $kv.1;
  }
  $sum
}

macro add_internal_variable(x)
{
  let $y : typeof(x);
  if true {
    $y = 1;
  }
  x + $y
}

macro hygienic_assignment(x)
{
  $y = x + 1;
  $y
}

macro hygienic_declaration(x)
{
  let $y = x + 1;
  $y
}

macro bare_one()
{
  $x = 1;
  $x
}

macro ident_source()
{
  2
}

macro ident_argument(ident_source)
{
  ident_source
}

macro duplicate_expression(x)
{
  $y = x + 1;
  $z = x + 2;
  $y + $z
}

macro repeat_expression(x)
{
  _ = x;
  _ = x;
  _ = x;
}

macro first_map_key(@x)
{
  let $result;
  for $kv : @x {
    $result = $kv.0;
    break;
  }
  $result
}

macro indirect_second(a, b)
{
  (a, b)
}

macro indirect_first(@b, $x)
{
  indirect_second(@b, $x)
}

test:macro_variable_arguments
{
  $a = 1;
  increment_variable($a);

  if ($a != 2) {
    return 1;
  }

  $b = 1;
  $result = increment_and_return($b);

  if ($b != 2) {
    return 1;
  }

  if ($result != 2) {
    return 1;
  }

  increment_variable($a);
  increment_variable($a);

  if ($a != 4) {
    return 1;
  }
}

test:macro_map_arguments
{
  @macro_map_arguments_a[1] = 1;
  set_map_element(@macro_map_arguments_a);

  if (@macro_map_arguments_a[1] != 2) {
    return 1;
  }

  @macro_map_arguments_b = 1;
  set_scalar_map(@macro_map_arguments_b);

  if (@macro_map_arguments_b != 2) {
    return 1;
  }

  @macro_map_arguments_c[1] = 1;

  if (read_map_element(@macro_map_arguments_c) != 2) {
    return 1;
  }
}

test:macro_nested_calls
{
  if (expression_add3(1) != 4) {
    return 1;
  }

  $a = 1;
  statement_add3($a);

  if ($a != 4) {
    return 1;
  }

  if (order_add3(1) != 4) {
    return 1;
  }
}

test:macro_expression_arguments
{
  $a = 1;
  @macro_expression_arguments = 1;

  if (add_one(1 + 1) != 3) {
    return 1;
  }

  if (add_one($a + 1) != 3) {
    return 1;
  }

  if (add_one_nested($a + 1) != 6) {
    return 1;
  }

  if (add_one(@macro_expression_arguments + 1) != 3) {
    return 1;
  }

  if (add_one(add_one(1) + 1) != 4) {
    return 1;
  }

  if (add_one(add_one(add_one(1))) != 4) {
    return 1;
  }
}

test:macro_typeof_arguments
{
  if (sizeof_types(typeof(uint64*), typeof(struct macro_typeof_struct)) != 25) {
    return 1;
  }

  if (nested_sizeof_outer(typeof(uint64*)) != 10) {
    return 1;
  }

  if (nested_type_cast(typeof(uint8)) != 0xff) {
    return 1;
  }
}

test:macro_for_loop
{
  @macro_for_loop[1] = 5;
  @macro_for_loop[2] = 10;

  if (sum_map_values(@macro_for_loop) != 16) {
    return 1;
  }
}

test:macro_nested_scope
{
  $a = 1;
  $result = 0;

  if ($a == 1) {
    $result = expression_add2($a);
  } else {
    $result = expression_add1($a);
  }

  if ($result != 3) {
    return 1;
  }
}

test:macro_variable_hygiene
{
  if (add_internal_variable(1) != 2) {
    return 1;
  }

  $y = 2;

  if (hygienic_assignment(5) != 6) {
    return 1;
  }

  if ($y != 2) {
    return 1;
  }

  if (hygienic_declaration(5) != 6) {
    return 1;
  }

  if ($y != 2) {
    return 1;
  }
}

test:macro_bare_identifier
{
  if (bare_one != 1) {
    return 1;
  }

  if (ident_argument(1) != 1) {
    return 1;
  }
}

test:macro_repeated_expression
{
  $y = 2;
  $result = duplicate_expression({
                                   $y += 1;
                                   $y
                                 });

  if ($result != 10) {
    return 1;
  }

  if ($y != 4) {
    return 1;
  }

  $count = 0;
  repeat_expression({
                      $count++;
                      $count
                    });

  if ($count != 3) {
    return 1;
  }
}

test:macro_iterable_clone
{
  @macro_iterable_clone_a[1] = 0;
  @macro_iterable_clone_b[2] = 0;

  if (first_map_key(@macro_iterable_clone_a) != 1) {
    return 1;
  }

  if (first_map_key(@macro_iterable_clone_b) != 2) {
    return 1;
  }
}

test:macro_indirect_arguments
{
  @macro_indirect_arguments = 5;
  $value = 1;
  $result = indirect_first(@macro_indirect_arguments, $value);

  if ($result.0 != 5) {
    return 1;
  }

  if ($result.1 != 1) {
    return 1;
  }
}

