struct pointer_math_struct {
  int a;
  int b;
  char c[28];
};

test:pointer_increment
{
  $p8 = (int8*)0x32;
  $p8 += 1;

  if ($p8 != 0x33) {
    return 1;
  }

  $p16 = (int16*)0x32;
  $p16 += 1;

  if ($p16 != 0x34) {
    return 1;
  }

  $p32 = (int32*)0x32;
  $p32 += 1;

  if ($p32 != 0x36) {
    return 1;
  }

  $p64 = (int64*)0x32;
  $p64 += 1;

  if ($p64 != 0x3a) {
    return 1;
  }
}

test:pointer_post_increment
{
  $p8 = (int8*)0x32;
  $p8++;

  if ($p8 != 0x33) {
    return 1;
  }

  $p16 = (int16*)0x32;
  $p16++;

  if ($p16 != 0x34) {
    return 1;
  }

  $p32 = (int32*)0x32;
  $p32++;

  if ($p32 != 0x36) {
    return 1;
  }

  $p64 = (int64*)0x32;
  $p64++;

  if ($p64 != 0x3a) {
    return 1;
  }
}

test:pointer_pre_increment
{
  $p8 = (int8*)0x32;
  ++$p8;

  if ($p8 != 0x33) {
    return 1;
  }

  $p16 = (int16*)0x32;
  ++$p16;

  if ($p16 != 0x34) {
    return 1;
  }

  $p32 = (int32*)0x32;
  ++$p32;

  if ($p32 != 0x36) {
    return 1;
  }

  $p64 = (int64*)0x32;
  ++$p64;

  if ($p64 != 0x3a) {
    return 1;
  }
}

test:pointer_decrement
{
  $p = (int32*)0x32;
  $p -= 1;

  if ($p != 0x2e) {
    return 1;
  }

  $q = (int32*)0x32;
  $q--;

  if ($q != 0x2e) {
    return 1;
  }
}

test:pointer_arithmetic_by_offset
{
  $p = (int32*)0x32;
  $p += 6;

  if ($p != 0x4a) {
    return 1;
  }

  $q = (int32*)0x32;
  $q -= 6;

  if ($q != 0x1a) {
    return 1;
  }
}

test:struct_pointer_math
{
  $p = (struct pointer_math_struct*)1024;

  if (sizeof(struct pointer_math_struct) != 36) {
    return 1;
  }

  if (($p - 5) != 844) {
    return 1;
  }
}

test:map_pointer_arithmetic
{
  @pointer_inc = (int8*)0x32;
  @pointer_inc += 1;

  if (@pointer_inc != 0x33) {
    return 1;
  }

  @pointer_dec = 4;
  @pointer_val = (int32*)0x32;
  @pointer_val -= @pointer_dec;

  if (@pointer_val != 0x22) {
    return 1;
  }
}

test:pointer_int_comparison
{
  $p = (int64*)0x32;
  $p++;

  if (!(0x32 < $p && $p > 0x32)) {
    return 1;
  }
}
