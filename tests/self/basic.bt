test:noop
{}

test:increment_decrement_map
{
  @x = 10;

  if ((@x++) != 10) {
    return 1;
  }
  if ((++@x) != 12) {
    return 1;
  }
  if ((@x--) != 12) {
    return 1;
  }
  if ((--@x) != 10) {
    return 1;
  }

  _ = delete(@x);
}

test:increment_decrement_variable
{
  $x = 10;

  if (($x++) != 10) {
    return 1;
  }
  if ((++$x) != 12) {
    return 1;
  }
  if (($x--) != 12) {
    return 1;
  }
  if ((--$x) != 10) {
    return 1;
  }
}

test:variable_strings_are_memset
{
  $x = "xxxxx";
  $x = "a";

  @variable_strings_are_memset[$x] = 1;
  $y = "yyyyy";
  $y = "a";

  @variable_strings_are_memset[$y] = 1;

  if (len(@variable_strings_are_memset) != 1) {
    return 1;
  }
}

test:map_strings_are_memset
{
  @map_strings_are_memset_x = "xxxxx";
  @map_strings_are_memset_x = "a";
  @map_strings_are_memset[@map_strings_are_memset_x] = 1;
  @map_strings_are_memset_y = "yyyyy";
  @map_strings_are_memset_y = "a";
  @map_strings_are_memset[@map_strings_are_memset_y] = 1;

  if (len(@map_strings_are_memset) != 1) {
    return 1;
  }

  _ = delete(@map_strings_are_memset_x);
  _ = delete(@map_strings_are_memset_y);
}

test:basic_while_loop
{
  $a = 0;
  while ($a <= 100) {
    @basic_while_loop = avg($a++);
  }

  if (@basic_while_loop != 50) {
    return 1;
  }
}

test:nested_while_loop
{
  $i = 0;
  while ($i < 3) {
    $j = 0;
    while ($j < 2) {
      @nested_while_loop = count();
      $j++;
    }
    $i++;
  }

  if (@nested_while_loop != 6) {
    return 1;
  }
}

test:while_loop_let_without_assignment_is_zeroed_each_iteration
{
  $y = 0;
  $i = 0;
  while ($i < 3) {
    let $z;
    if ($i == 0) {
      $z = 5;
    }
    $y += $z;
    $i++;
  }

  if ($y != 5) {
    return 1;
  }
}

test:block_expression
{
  let $a = {
    let $b = 1;
    $b
  };
  if ($a != 1) {
    return 1;
  }
}

test:block_expression_complex
{
  $x = {
    $y = {
      $z = 10;
      $z + 5
    };
    $y * 2
  };

  if ($x != 30) {
    return 1;
  }
}

test:block_expression_with_condition
{
  $taken = false;
  if ({
       let $a = true;
       $a
     }) {
    $taken = true;
  }

  if (!$taken) {
    return 1;
  }
}

test:logical_and_with_different_types
{
  $x = 5;
  $y = true;

  if (!($x && $y)) {
    return 1;
  }
}

test:logical_or_with_different_types
{
  $x = 0;
  $y = true;

  if (!($x || $y)) {
    return 1;
  }
}

test:operator_precedence_1
{
  if (1 + 2 * 3 != 7) {
    return 1;
  }
}

test:operator_precedence_2
{
  if (1 + 2 * 3 + 1 != 8) {
    return 1;
  }
}

test:operator_precedence_3
{
  if (1 + 2 * 3 + 1 * 10 != 17) {
    return 1;
  }
}

test:operator_precedence_4
{
  if (1 + 2 / 2 * 3 != 4) {
    return 1;
  }
}

