// :summary Determine whether the given expression is a string.
// :variant bool is_str(any expression)
macro is_str(expr)
{
  typeinfo(expr).base_type == "string"
}

// :summary Determine whether the given expression is a pointer.
// :variant bool is_ptr(any expression)
macro is_ptr(expr)
{
  typeinfo(expr).base_type == "pointer"
}

// :summary Determine whether the given expression is an array.
// :variant bool is_array(any expression)
macro is_array(expr)
{
  typeinfo(expr).base_type == "array"
}

// :summary Determine whether the given expression is an integer.
// :variant bool is_integer(any expression)
macro is_integer(expr)
{
  typeinfo(expr).base_type == "int"
}

// :summary Determine whether the given expression is an unsigned integer.
// :variant bool is_unsigned_integer(any expression)
macro is_unsigned_integer(expr)
{
  typeinfo(expr).base_type == typeinfo(0).base_type &&
  typeinfo(expr).full_type[0] == "u"[0]
}

// :summary Assert something is true or fail the build.
// :variant void static_assert(bool condition, string msg)
macro static_assert(cond, msg)
{
  if comptime (!cond) {
    fail(msg);
  }
}

macro check_key(@map, key, func)
{
  if comptime is_scalar(@map) {
    fail("call to %s expects a map with explicit keys (non-scalar map)", func);
  } else {
    // This is a bit of a hack as it both checks if the passed key is compatible
    // with the map key and it also possibly changes the key type to make them
    // compatible if possible, e.g.
    // @c[1, ("hello", (int8)5)] = 0;
    // has_key(@c, (1, ("hello", (uint8)5))) - now the key type is (uint8, (string, int16))
    // Other than that this has no side effects and shouldn't fail
    if comptime (typeinfo(@map[key]).base_type == "__dummy_key_type") {
      fail("__dummy_key_type shouldn't exist");
    }
  }
}

// :summary Returns true if the passed expression is a literal, e.g. 1, true, "hello"
// :variant bool is_literal(Expression expr)
macro is_literal(expr)
{
  __builtin_is_literal(expr)
}

macro assert_userspace_probe(func)
{
  if comptime (probetype != "uprobe" && probetype != "uretprobe" && probetype != "usdt") {
    fail("%s can not be used for this probetype: %s", func, probetype);
  }
}

macro elf_is_exe()
{
  assert_userspace_probe("elf_is_exe");
  __builtin_elf_is_exe
}

macro elf_info()
{
  assert_userspace_probe("elf_info");
  __builtin_elf_ino
}

// :summary Finds the containing object from a pointer to one of its members.
// :variant Container* container_of(Member* ptr, Type type, Identifier member)
macro container_of(ptr, type, member)
{
  $vptr = (void*)ptr;
  (type*)($vptr - offsetof(type, member))
}
