// String helpers.
//
// This file contains various string-related functions and helpers. Strings are
// complex, especially C strings. In general, the complexities come from the
// need for dynamically-sized types or dynamic memory management. In bpftrace,
// we introduce an automatic parameterized `string` type in order to make this
// simpler, but it also makes it more complex. These string helpers are
// intended to operate uniformally on the wider class of "string-like" objects.
//
// This means that these functions should efficiently support:
//  * Pointers to int8 (signed char)
//  * Arrays of int8
//  * Native bpftrace `string` objects of various sizes

// :summary Checks that this value is string-like.
// :variant void assert_str(any expression)
macro assert_str(exp)
{
  if comptime (!is_str(exp)) {
    if comptime is_array(exp) {
      // wrap exp in parens to force it to be evaluated as an expression
      static_assert(typeinfo((exp[0])) == typeinfo(int8),
                    "string-like arrays must contain a char-like type");
    } else if comptime is_ptr(exp) {
      static_assert(typeinfo((exp[0])) == typeinfo(int8),
                    "string-like pointers must point to a char-like type");
    } else {
      fail("string-like values must be either strings, arrays or pointers");
    }
  }
}

// :summary Returns the default unbounded length.
// :variant uint64 default_str_length()
macro default_str_length()
{
  sizeof(str((int8*)0))
}

// :summary Returns the length of a string-like object.
// :variant uint64 strlen(string exp)
// :variant uint64 strlen(int8 exp[])
// :variant uint64 strlen(int8 *exp)
macro strlen($var)
{
  assert_str($var);
  let $sz = (int64)0;
  if comptime is_str($var) {
    $sz = __strnlen(&$var, sizeof($var));
  } else if comptime is_array($var) {
    $sz = __strnlen($var, sizeof($var));
  } else {
    $sz = __strnlen($var, default_str_length());
  }
  (uint64)$sz
}

macro strlen(exp)
{
  assert_str(exp);
  if comptime (is_str(exp) || is_array(exp)) {
    // This must be unbound, unfortunately we need to bind it.
    let $x = exp;
    strlen($x)
  } else {
    (uint64)__strnlen(exp, default_str_length())
  }
}

macro __strnlen(ptr, max_size)
{
  import "stdlib/strings/strings.bpf.c";
  __bpf_strnlen((int8*)ptr, (size_t)max_size)
}

// :summary Returns the capacity of a string-like object.
//
// In most cases this is the same as the length, but for bpftrace-native
// strings and arrays, this is the underlying object capacity. This is used to
// bound searches and lookups without needing to scan the string itself.
// :variant int64 strcap(string exp)
// :variant int64 strcap(int8 exp[])
// :variant int64 strcap(int8 *exp)
macro strcap(exp)
{
  assert_str(exp);
  if comptime is_str(exp) {
    sizeof(exp)
  } else if comptime is_array(exp) {
    sizeof(exp) / sizeof((exp[0]))
  } else {
    strlen(exp) // Pointer, so pass by value.
  }
}

// :summary Returns the index of the first occurrence of one string in another, or -1 if not found.
// :variant int64 strstr(string haystack, string needle)
macro strstr($haystack, $needle)
{
  import "stdlib/strings/strings.bpf.c";
  assert_str($haystack);
  assert_str($needle);
  let $haystack_size = strcap($haystack);
  let $needle_size = strcap($needle);
  if ($needle_size == 0) {
    // Special case: the needle is zero-sized.
    0
  } else if ($needle[0] == 0) {
    // Special case: the needle is empty.
    0
  } else {
    __bpf_strnstr((int8*)(&$haystack),
                  (int8*)(&$needle), (uint64)$haystack_size, (uint64)$needle_size)
  }
}
macro strstr($haystack, needle)
{
  let $needle = needle;
  strstr($haystack, $needle)
}
macro strstr(haystack, $needle)
{
  let $haystack = haystack;
  strstr($haystack, $needle)
}
macro strstr(haystack, needle)
{
  let $haystack = haystack;
  strstr($haystack, needle)
}

// :summary Concatenates two strings into a new string.
// :variant string str_concat(string s1, string s2)
macro str_concat($s1, $s2) {
  import "stdlib/strings/strings.bpf.c";

  let $new : string[1024] = "";

  assert_str($s1);
  assert_str($s2);

  let $new_sz = strcap($new);

  _ = __bpf_str_concat((int8 *)&$new, (uint64)$new_sz, (int8 *)&$s1);
  _ = __bpf_str_concat((int8 *)&$new, (uint64)$new_sz, (int8 *)&$s2);

  $new
}

macro str_concat($s1, s2) {
  let $s2 = s2;
  str_concat($s1, $s2)
}

macro str_concat(s1, $s2) {
  let $s1 = s1;
  str_concat($s1, $s2)
}

macro str_concat(s1, s2) {
  let $s1 = s1;
  str_concat($s1, s2)
}

// :summary Checks whether one string contains another.
// :variant bool strcontains(string haystack, string needle)
// Compares whether the string haystack contains the string needle.
//
// If needle is contained then true is returned, else false is returned.
macro strcontains(haystack, needle)
{
  strstr(haystack, needle) >= 0
}

// :summary Converts an error number to its description.
// :variant string strerror(int error)
//
// ```
// #include <errno.h>
// begin {
//   print(strerror(EPERM));
// }
// ```
macro strerror(errno)
{
  import "stdlib/strings/strings.bpf.c";
  let $v : string[64];
  __strerror((int32)errno, &$v);
  $v
}

// :summary Converts a signal number to its name.
// :variant string signal_name(int sig)
//
// ```
// #include <signal.h>
// begin {
//   print(signal_name(SIGINT));
// }
// ```
macro signal_name(sig)
{
  import "stdlib/strings/strings.bpf.c";
  let $v : string[64];
  __signal_name((int32)sig, &$v);
  $v
}

// :summary Converts a system call number to its name.
// :variant string syscall_name(int nr_syscall)
//
// ```
// #include <syscall.h>
// begin {
//   print(syscall_name(__NR_read)); // outputs "read"
// }
// ```
macro syscall_name(n)
{
  import "stdlib/strings/strings.bpf.c";
  let $v : string[64];
  __syscall_name((int32)n, &$v);
  $v
}
